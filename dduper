#!/usr/bin/env python3
"""Compatibility entry point for the maintained Rust implementation.

No numpy/PTable or persistent Python checksum cache is required. The Rust
caller reports helper filename, exit status, stderr and unavailable checksums.
"""
import os
from pathlib import Path
import sys


def main():
    here = Path(__file__).resolve()
    override = os.environ.get("DDUPER_BIN")
    candidates = [Path(override)] if override else [
        here.parent / "target/release/dduper",
        Path("/usr/local/sbin/dduper"),
        Path("/usr/sbin/dduper"),
    ]
    for binary in candidates:
        if binary.is_file() and binary.resolve() != here:
            try:
                os.execv(str(binary), [str(binary), *sys.argv[1:]])
            except OSError as error:
                print(f"dduper: cannot execute {binary}: {error}", file=sys.stderr)
                return 1
    print("dduper: Rust executable unavailable; run cargo build --release --bins "
          "or set DDUPER_BIN to the built executable (see INSTALL.md)", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
